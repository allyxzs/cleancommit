{
  "fail_on": "error",
  "language": "pt",
  "limits": {
    "max_files": 25,
    "max_lines": 600,
    "max_file_lines": 300,
    "max_file_size_kb": 512
  },
  "ignore_paths": ["vendor/", "docs/legacy/**", "*.generated.ts"],
  "allow_files": [".vscode/settings.json"],
  "disable": ["py-print", "todo-marker"],
  "forbidden_files": [
    { "pattern": "*.sqlite", "severity": "error", "message": "Bancos locais não devem ser versionados" },
    { "pattern": "*.tfstate", "severity": "error", "message": "State do Terraform contém segredos" }
  ],
  "rules": [
    {
      "id": "no-fixme",
      "description": "Bloqueia FIXME em código novo",
      "pattern": "FIXME",
      "severity": "error",
      "paths": ["src/**", "internal/**"],
      "message": "Resolva o FIXME antes de commitar"
    },
    {
      "id": "no-localhost",
      "pattern": "https?://(localhost|127\\.0\\.0\\.1)",
      "severity": "warning",
      "paths": ["src/**"],
      "message": "URL local hardcoded"
    }
  ]
}
